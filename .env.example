# Application
APP_ENV=development
APP_NAME=patient-health-agent

# Database
POSTGRES_DB=patient_health
POSTGRES_USER=patient_health
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://patient_health:change-me@postgres:5432/patient_health

# Authentication
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=patient-health
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/patient-health
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/patient-health/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=

# Object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=patient-records
MINIO_SECURE=false

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TAVILY_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b

# Video
# Point this at your self-hosted Jitsi Meet web URL.
JITSI_BASE_URL=http://localhost:8443

# Email (local development)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@patient-health.local
